{
  "name": "chicks-cannon",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @chicks-cannon/web",
    "dev:api": "npm run start --workspace @chicks-cannon/api",
    "build": "npm run build --workspace @chicks-cannon/web && npm run build --workspace @chicks-cannon/api",
    "test": "npm run test --workspaces --if-present"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
